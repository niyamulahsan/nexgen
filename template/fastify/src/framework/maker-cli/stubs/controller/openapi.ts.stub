import type { FastifyReply, FastifyRequest } from "fastify";
import { HttpStatusCodes } from "@/framework/facade.js";
import { {{ServiceName}} } from "@/modules/{{module}}/services/{{controller}}.js";

type IdRequest = FastifyRequest<{ Params: { id: number } }>;
type BodyRequest = FastifyRequest<{ Body: Record<string, unknown> }>;
type UpdateRequest = FastifyRequest<{ Params: { id: number }; Body: Record<string, unknown> }>;

/**
 * Why: Returns every {{controller}} row for list screens.
 * When: Used by GET list endpoint.
 * Where: GET /{{controller}} route.
 */
export const index = async (_request: FastifyRequest, reply: FastifyReply) => {
  const data = await {{ServiceName}}.list();

  return reply.code(HttpStatusCodes.OK).send({ message: "{{controller}} list fetched successfully", data });
};

/**
 * Why: Returns one {{controller}} row by validated route id.
 * When: Used by detail screens or fetch-by-id calls.
 * Where: GET /{{controller}}/:id route.
 */
export const show = async (request: IdRequest, reply: FastifyReply) => {
  const data = await {{ServiceName}}.findOne(request.params.id);

  if (!data) {
    return reply.code(HttpStatusCodes.NOT_FOUND).send({ message: "{{controller}} not found" });
  }

  return reply.code(HttpStatusCodes.OK).send({ message: "{{controller}} fetched successfully", data });
};

/**
 * Why: Creates a new {{controller}} row from a validated request body.
 * When: Used by create form submissions.
 * Where: POST /{{controller}} route.
 */
export const store = async (request: BodyRequest, reply: FastifyReply) => {
  const data = await {{ServiceName}}.create(request.body);

  return reply.code(HttpStatusCodes.CREATED).send({ message: "{{controller}} created successfully", data });
};

/**
 * Why: Updates an existing {{controller}} row using id + body validation.
 * When: Used by edit/update form submissions.
 * Where: PUT/PATCH /{{controller}}/:id route.
 */
export const update = async (request: UpdateRequest, reply: FastifyReply) => {
  const data = await {{ServiceName}}.update(request.params.id, request.body);

  if (!data) {
    return reply.code(HttpStatusCodes.NOT_FOUND).send({ message: "{{controller}} not found" });
  }

  return reply.code(HttpStatusCodes.OK).send({ message: "{{controller}} updated successfully", data });
};

/**
 * Why: Deletes one {{controller}} row by validated route id.
 * When: Used by delete actions.
 * Where: DELETE /{{controller}}/:id route.
 */
export const destroy = async (request: IdRequest, reply: FastifyReply) => {
  const data = await {{ServiceName}}.remove(request.params.id);

  if (!data) {
    return reply.code(HttpStatusCodes.NOT_FOUND).send({ message: "{{controller}} not found" });
  }

  return reply.code(HttpStatusCodes.OK).send({ message: "{{controller}} deleted successfully" });
};
